{
	"operationId": "checkVersion",
	"summary": "Returns stable release version data from the fork's Docker Hub repository",
	"tags": ["public"],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"current": "1.5.0",
								"latest": "1.5.0",
								"update_available": true
							}
						}
					},
					"schema": {
						"$ref": "../../../components/check-version-object.json"
					}
				}
			}
		}
	}
}
